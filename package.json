{
  "name": "xe-utils",
  "version": "4.2.3",
  "description": "JavaScript 函数库、工具类",
  "main": "index.js",
  "module": "es/index.esm.js",
  "unpkg": "lib/index.umd.min.js",
  "jsdelivr": "lib/index.umd.min.js",
  "typings": "index.d.ts",
  "scripts": {
    "update": "npm install --legacy-peer-deps",
    "lib": "node scripts/build.js",
    "lint:es": "eslint src/**",
    "lint:ox": "oxfmt --check src/***",
    "esfix": "eslint --fix src/**",
    "oxfix": "oxfmt src/** --write",
    "test": "npm run lib && jest",
    "clean:all": "node scripts/clean-all"
  },
  "files": [
    "dist",
    "es",
    "lib",
    "src",
    "*.js",
    "*.ts"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "20.14.8",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "del": "~6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-flat": "^1.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "esbuild": "^0.28.2",
    "oxfmt": "~0.51.0",
    "jest": "~30.0.4",
    "terser": "~5.51.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-extends/xe-utils.git"
  },
  "keywords": [
    "utils",
    "js-util",
    "js-tool",
    "xe-utils",
    "tools"
  ],
  "author": {
    "name": "Xu Liangzhan",
    "email": "xu_liangzhan@163.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/x-extends/xe-utils/issues"
  },
  "homepage": "https://github.com/x-extends/xe-utils#readme",
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  }
}
